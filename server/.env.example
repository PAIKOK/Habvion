# Copy to server/.env. Blank values are unset. Never commit server/.env.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SESSION_SECRET=
AUTH_COOKIE_NAME=hb_session
GOOGLE_CLIENT_ID=
MONGODB_URI=
USERS_FILE=./data/users.json
DESIGNS_FILE=./data/designs.json
MESSAGES_FILE=./data/messages.json
# Optional: send each contact enquiry to Google Sheets + email (see docs/CONTACT-GOOGLE-SHEETS.md)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# true: forward every enquiry to the web app above (needs the URL and secret).
CONTACT_FORWARDING_ENABLED=false
ASSETS_DIR=./data/assets
MESH_PROVIDER=mock
TRIPO_API_KEY=
TRIPO_MODEL=v2.5-20250123
