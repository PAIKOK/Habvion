# Vercel environment template. Add values in Project Settings > Environment Variables.
# Do not put real credentials in this example or send them through chat.
# Rotate any previously exposed database password BEFORE using its new connection URI.
MONGODB_URI=
SESSION_SECRET=
CORS_ORIGIN=
# At least 32 random characters; Vercel sends it as a Bearer token to /api/retention.
CRON_SECRET=
# Disable Vercel's body helpers so Express owns request body parsing.
NODEJS_HELPERS=0

# Keyless demo by default. For real AI, use gemini and set GOOGLE_API_KEY privately.
AI_PROVIDER=mock
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AUTH_COOKIE_NAME=hb_session
GOOGLE_CLIENT_ID=

# Off by default. Review third-party processing before enabling.
CONTACT_FORWARDING_ENABLED=false
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Generated photo-to-3D jobs are disabled by the Vercel adapter, even if a key is set.
# Built-in furniture and 2D/3D previews do not need a mesh provider key.
